@model List<BMSBT.ViewModels.BillsSummaryCombinedViewModel>
@{
    ViewData["Title"] = "Bill Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var months = ViewBag.Months as List<string> ?? new List<string>();
    var years = ViewBag.Years as List<string> ?? new List<string>();
    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
    var totalCustomers = Model?.Sum(x => x.Customers) ?? 0;
    var totalBillsGenerated = Model?.Sum(x => x.BillsGenerated) ?? 0;
    var generationRate = totalCustomers > 0
        ? ((double)totalBillsGenerated / totalCustomers) * 100
        : 0;
}

<style>
    .bill-summary-page {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 0.5rem 1.5rem;
    }

    .page-hero {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .page-title {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 700;
        color: #0f172a;
    }

    .page-subtitle {
        margin: 0.35rem 0 0;
        color: #64748b;
        font-size: 0.98rem;
    }

    .period-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: #e0f2fe;
        color: #075985;
        font-weight: 700;
        white-space: nowrap;
    }

    .filter-section {
        padding: 1rem 1.1rem;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid #dbe4ee;
        border-radius: 14px;
        margin-bottom: 1rem;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 240px));
        gap: 1rem;
        align-items: end;
    }

    .filter-grid .form-group {
        margin-bottom: 0;
    }

    .filter-grid .form-control {
        min-height: 44px;
        border-radius: 10px;
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .summary-card {
        padding: 1.15rem 1.25rem;
        background: #ffffff;
        border: 1px solid #dbe4ee;
        border-radius: 14px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .summary-card-label {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin-bottom: 0.45rem;
    }

    .summary-card-value {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1;
    }

    .summary-card-note {
        margin-top: 0.35rem;
        color: #64748b;
        font-size: 0.92rem;
    }

    .table-card {
        background: #ffffff;
        border: 1px solid #dbe4ee;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.05);
    }

    .table-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1rem 1.25rem;
        background: linear-gradient(180deg, #f8fbff 0%, #f1f5f9 100%);
        border-bottom: 1px solid #dbe4ee;
    }

    .table-card-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
    }

    .table-card-note {
        margin: 0.25rem 0 0;
        color: #64748b;
        font-size: 0.92rem;
    }

    .table-responsive {
        margin: 0;
    }

    .summary-table {
        width: 100%;
        border-collapse: collapse;
        background-color: #ffffff;
        margin-top: 0;
    }

    .summary-table th,
    .summary-table td {
        border-bottom: 1px solid #e2e8f0;
        padding: 14px 18px;
        text-align: left;
    }

    .summary-table th {
        background-color: #0f5fa8;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .summary-table tbody tr:nth-child(even) {
        background-color: #f8fafc;
    }

    .summary-table tbody tr:hover {
        background-color: #eef6ff;
    }

    .summary-table tfoot td {
        font-weight: 800;
        background-color: #e0f2fe;
        border-top: 2px solid #7dd3fc;
        padding: 15px 18px;
    }

    .summary-table td.numeric,
    .summary-table th.numeric {
        text-align: right;
    }

    .project-cell {
        font-weight: 600;
        color: #0f172a;
    }

    .metric-chip {
        display: inline-flex;
        min-width: 72px;
        justify-content: center;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 700;
    }

    .form-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.45rem;
    }

    .no-data {
        color: #6c757d;
        font-style: italic;
        padding: 28px 20px;
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .filter-grid,
        .summary-cards {
            grid-template-columns: 1fr;
        }

        .summary-card-value {
            font-size: 1.65rem;
        }
    }
</style>

<div class="container-fluid mt-3">
    <div class="bill-summary-page">
        <div class="page-hero">
            <div>
                <h4 class="page-title">Bills Summary by Project</h4>
                <p class="page-subtitle">A wider, cleaner summary view for comparing customer counts and generated bills across projects.</p>
            </div>
            <div class="period-badge">@selectedMonth @selectedYear</div>
        </div>

        <form id="billsSummaryForm" asp-controller="Home" asp-action="BillSummary" method="get" class="filter-section">
            <div class="filter-grid">
                <div class="form-group">
                <label class="form-label">Month</label>
                <select name="month" id="monthDropdown" class="form-control" style="min-width: 160px;">
                    <option value="">-- Select Month --</option>
                    @foreach (var m in months)
                    {
                        if (m == selectedMonth)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>
                </div>
                <div class="form-group">
                <label class="form-label">Year</label>
                <select name="year" id="yearDropdown" class="form-control" style="min-width: 100px;">
                    <option value="">-- Select Year --</option>
                    @foreach (var y in years)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-block w-100">Show Report</button>
                </div>
            </div>
        </form>

        <div class="summary-cards">
            <div class="summary-card">
                <div class="summary-card-label">Total Customers</div>
                <div class="summary-card-value">@totalCustomers.ToString("N0")</div>
                <div class="summary-card-note">Customers available across all projects</div>
            </div>
            <div class="summary-card">
                <div class="summary-card-label">Bills Generated</div>
                <div class="summary-card-value">@totalBillsGenerated.ToString("N0")</div>
                <div class="summary-card-note">Bills created for the selected month and year</div>
            </div>
            <div class="summary-card">
                <div class="summary-card-label">Generation Rate</div>
                <div class="summary-card-value">@generationRate.ToString("0.0")%</div>
                <div class="summary-card-note">Generated bills compared to total customers</div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-card-header">
                <div>
                    <h5 class="table-card-title">Project-wise Report</h5>
                    <p class="table-card-note">Use this table to compare customer counts and generated bills side by side.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="summary-table table mb-0">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th class="numeric">Customers</th>
                            <th class="numeric">Bills Generated</th>
                        </tr>
                    </thead>
                    <tbody id="summaryTableBody">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var row in Model)
                            {
                                <tr>
                                    <td class="project-cell">@row.Project</td>
                                    <td class="numeric"><span class="metric-chip">@row.Customers.ToString("N0")</span></td>
                                    <td class="numeric"><span class="metric-chip">@row.BillsGenerated.ToString("N0")</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="no-data">@(string.IsNullOrEmpty(selectedMonth) || string.IsNullOrEmpty(selectedYear) ? "Select a month and year, then click Show." : "No customer data.")</td>
                            </tr>
                        }
                    </tbody>
                    @if (Model != null && Model.Any())
                    {
                        <tfoot>
                    <tr>
                        <td>Total</td>
                        <td class="numeric">@totalCustomers.ToString("N0")</td>
                        <td class="numeric">@totalBillsGenerated.ToString("N0")</td>
                    </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var form = document.getElementById('billsSummaryForm');
        var monthDropdown = document.getElementById('monthDropdown');
        var yearDropdown = document.getElementById('yearDropdown');
        var useAjax = false;

        function hasSelection() {
            return monthDropdown.value && yearDropdown.value;
        }

        function submitForm() {
            if (hasSelection()) form.submit();
        }

        monthDropdown.addEventListener('change', function () {
            if (useAjax) {
                fetchSummaryData();
            } else {
                submitForm();
            }
        });
        yearDropdown.addEventListener('change', function () {
            if (useAjax) {
                fetchSummaryData();
            } else {
                submitForm();
            }
        });

        function fetchSummaryData() {
            if (!hasSelection()) return;
            var month = monthDropdown.value;
            var year = yearDropdown.value;
            var url = '@Url.Action("GetBillSummaryData", "Home")?month=' + encodeURIComponent(month) + '&year=' + encodeURIComponent(year);
            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var tbody = document.getElementById('summaryTableBody');
                    tbody.innerHTML = '';
                    if (data && data.length > 0) {
                        data.forEach(function (row) {
                            var tr = document.createElement('tr');
                            tr.innerHTML = '<td class="project-cell">' + (row.project || '') + '</td><td class="numeric"><span class="metric-chip">' + (row.customers || 0) + '</span></td><td class="numeric"><span class="metric-chip">' + (row.billsGenerated || 0) + '</span></td>';
                            tbody.appendChild(tr);
                        });
                    } else {
                        var tr = document.createElement('tr');
                        tr.innerHTML = '<td colspan="3" class="no-data">No records for the selected month and year.</td>';
                        tbody.appendChild(tr);
                    }
                })
                .catch(function () {
                    submitForm();
                });
        }
    })();
</script>
