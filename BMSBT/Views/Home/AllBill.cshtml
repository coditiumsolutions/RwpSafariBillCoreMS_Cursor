@model BMSBT.Models.PaginationViewModel<BMSBT.ViewModels.MaintenanceBillViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "All Bill";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var projects = ViewBag.Projects as List<string> ?? new List<string>();
    var selectedProject = ViewBag.SelectedProject as string ?? "";
    var selectedPhase = ViewBag.SelectedPhase as string ?? "";
    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
    var custNoOrName = ViewBag.CustNoOrName as string ?? "";
    var incompleteFilterSelection = (bool?)ViewBag.IncompleteFilterSelection ?? false;
    var monthNames = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12).Where(n => !string.IsNullOrEmpty(n)).ToList();
    var paginationStartPage = 1;
    var paginationEndPage = 1;
    if (Model != null && Model.TotalPages > 1)
    {
        const int maxPageLinks = 5;
        int current = Model.PageNumber;
        int total = Model.TotalPages;
        int endPage = Math.Min(total, current + (maxPageLinks / 2));
        int startPage = Math.Max(1, endPage - maxPageLinks + 1);
        if (endPage - startPage + 1 < maxPageLinks)
        {
            endPage = Math.Min(total, startPage + maxPageLinks - 1);
        }
        paginationStartPage = startPage;
        paginationEndPage = endPage;
    }
}

<style>
    .cm-detail-page {
        --cm-surface: #ffffff;
        --cm-heading: #0f172a;
        --cm-border: #e2e8f0;
        --cm-row-odd: #fafbfc;
        --cm-row-even: #ffffff;
        --cm-row-hover: #eef6ff;
        font-size: 0.9375rem;
        line-height: 1.45;
        color: #334155;
    }

    .cm-page-title {
        color: var(--cm-heading);
        font-weight: 700;
        margin-bottom: 0.85rem;
    }

    .cm-card {
        background: #ffffff;
        border: 1px solid var(--cm-border);
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .cm-card-header {
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        border-bottom: 1px solid var(--cm-border);
        padding: 0.75rem 1.25rem;
    }

    .cm-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
    }

    .cm-badge-soft {
        background: #e8f1ff;
        color: #1e40af;
        font-size: 0.7rem;
        border-radius: 4px;
        padding: 0.2rem 0.45rem;
        font-weight: 600;
    }

    .filter-section {
        padding: 1rem 1.25rem;
        background-color: #ffffff;
        border-bottom: 1px solid var(--cm-border);
        margin-bottom: 0;
    }

    .filter-section .form-control,
    .filter-section .btn {
        border-radius: 6px;
        font-size: 0.875rem;
    }

    .filter-section .form-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.3rem;
    }

    .cm-grid-container {
        padding: 1rem 1.25rem;
    }

    .cm-table-wrap {
        border: 1px solid var(--cm-border);
        border-radius: 6px;
        overflow: hidden;
    }

    .grid-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
        background-color: #ffffff;
    }

    .grid-table th,
    .grid-table td {
        border: 1px solid var(--cm-border);
        padding: 10px 12px;
        text-align: left;
    }

    .grid-table th {
        background: #f1f5f9;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .grid-table tbody tr:nth-child(odd) {
        background-color: var(--cm-row-odd);
    }

    .grid-table tbody tr:nth-child(even) {
        background-color: var(--cm-row-even);
    }

    .grid-table tbody tr:hover {
        background-color: var(--cm-row-hover);
    }

    .grid-table tbody tr.bill-row {
        cursor: pointer;
    }

    @@media print {
        .no-print { display: none !important; }
    }
    .no-data { color: #6c757d; font-style: italic; padding: 20px; }

    .cm-grid-pager {
        border-top: 1px solid var(--cm-border);
        background: #f8fafc;
        padding: 0.75rem 1rem 1rem;
        margin-top: 0;
    }

    .pagination-wrap {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
        border: 0;
    }
    .pagination-wrap .pagination {
        margin: 0;
        flex-wrap: wrap;
    }
    .pagination-wrap .page-item .page-link {
        padding: 6px 10px;
        min-width: 36px;
        text-align: center;
    }
    .pagination-wrap .go-to-page {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .pagination-wrap .go-to-page input[type="number"] {
        width: 56px;
        padding: 4px 6px;
        text-align: center;
    }
    .pagination-wrap .go-to-page label { margin-right: 4px; }
</style>

<div class="container-fluid mt-3 cm-detail-page">
    <h4 class="cm-page-title">All Bills</h4>
    <div class="cm-card">
        <div class="cm-card-header d-flex justify-content-between align-items-center flex-wrap">
            <h5 class="cm-card-title">Maintenance Bills</h5>
            <span class="cm-badge-soft">Total: @(Model?.TotalRecords ?? 0)</span>
        </div>

        <form asp-controller="Home" asp-action="AllBill" method="get" class="filter-section">
            <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Project</label>
                <select name="project" id="project" class="form-control">
                    <option value="">-- Select Project --</option>
                    @foreach (var p in projects)
                    {
                        if (p == selectedProject)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Phase</label>
                <select name="phase" id="phase" class="form-control">
                    <option value="">-- All Phases --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Billing Month</label>
                <select name="month" id="month" class="form-control">
                    <option value="">-- Month --</option>
                    @foreach (var name in monthNames)
                    {
                        if (name == selectedMonth)
                        {
                            <option value="@name" selected>@name</option>
                        }
                        else
                        {
                            <option value="@name">@name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Billing Year</label>
                <select name="year" id="year" class="form-control">
                    <option value="">-- Year --</option>
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 10; y--)
                    {
                        if (y.ToString() == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">BTNo/CustomerName</label>
                <input type="text" name="custNoOrName" id="custNoOrName" class="form-control" placeholder="BTNo or CustomerName (optional)" value="@custNoOrName" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Search Bills</button>
            </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <small class="text-muted">Use either: (1) Project + Billing Month + Billing Year, or (2) BTNo/CustomerName to search by either BTNo or CustomerName.</small>
                </div>
            </div>
        </form>

        <div class="cm-grid-container">
            @if (TempData["AllBillMessage"] != null)
            {
                <div class="alert alert-info">
                    @TempData["AllBillMessage"]
                </div>
            }

            @if (incompleteFilterSelection)
            {
                <div class="alert alert-warning">
                    Please select <strong>Project</strong>, <strong>Billing Month</strong>, and <strong>Billing Year</strong> together, or use <strong>BTNo/CustomerName</strong> only.
                </div>
            }

            <div class="cm-table-wrap">
                <div class="table-responsive">
                    <table class="table table-bordered grid-table">
                        <thead>
                            <tr>
                                <th>BTNo</th>
                                <th>Customer Name</th>
                                <th>Billing Month</th>
                                <th>Billing Year</th>
                                <th>Amount (Due Date)</th>
                                <th>Payment Status</th>
                                <th class="no-print">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.Items != null && Model.Items.Any())
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="bill-row" data-uid="@item.Uid" data-print-url="@Url.Action("Print", "MaintenanceNew", new { id = item.Uid, project = selectedProject })" ondblclick="window.open(this.getAttribute('data-print-url'), '_blank');">
                                        <td>@item.Btno</td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.BillingMonth</td>
                                        <td>@item.BillingYear</td>
                                        <td>@item.BillAmountInDueDate</td>
                                        <td>@item.PaymentStatus</td>
                                        <td class="no-print">
                                            <a asp-action="Print" asp-controller="MaintenanceNew" asp-route-id="@item.Uid" asp-route-project="@selectedProject" target="_blank" class="btn btn-sm btn-outline-primary">Print</a>
                                            <form asp-action="DeleteBill" asp-controller="Home" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Uid" />
                                                <input type="hidden" name="project" value="@selectedProject" />
                                                <input type="hidden" name="phase" value="@selectedPhase" />
                                                <input type="hidden" name="subProject" value="@selectedPhase" />
                                                <input type="hidden" name="month" value="@selectedMonth" />
                                                <input type="hidden" name="year" value="@selectedYear" />
                                                <input type="hidden" name="custNoOrName" value="@custNoOrName" />
                                                <input type="hidden" name="page" value="@(Model?.PageNumber ?? 1)" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Delete this bill permanently? This action cannot be undone.');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="no-data">
                                        @(string.IsNullOrEmpty(custNoOrName) && (string.IsNullOrEmpty(selectedProject) || string.IsNullOrEmpty(selectedMonth) || string.IsNullOrEmpty(selectedYear))
                                            ? "Select Project, Billing Month and Billing Year, or enter BTNo/CustomerName, then click Search Bills."
                                            : "No records found for the selected criteria.")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model != null && (!string.IsNullOrEmpty(custNoOrName) || (!string.IsNullOrEmpty(selectedProject) && !string.IsNullOrEmpty(selectedMonth) && !string.IsNullOrEmpty(selectedYear))))
            {
                <p class="mt-2 mb-1"><strong>Total Records:</strong> @Model.TotalRecords</p>
            }

            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="cm-grid-pager">
                    <div class="pagination-wrap">
                        <span class="text-muted small">
                            Showing @((Model.PageNumber - 1) * Model.PageSize + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords)) of @Model.TotalRecords
                        </span>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="AllBill"
                                       asp-route-project="@selectedProject"
                                       asp-route-phase="@selectedPhase"
                                       asp-route-month="@selectedMonth"
                                       asp-route-year="@selectedYear"
                                       asp-route-custNoOrName="@custNoOrName"
                                       asp-route-page="@(Model.PageNumber - 1)"
                                       aria-label="Previous">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = paginationStartPage; i <= paginationEndPage; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="AllBill"
                                           asp-route-project="@selectedProject"
                                           asp-route-phase="@selectedPhase"
                                           asp-route-month="@selectedMonth"
                                           asp-route-year="@selectedYear"
                                           asp-route-custNoOrName="@custNoOrName"
                                           asp-route-page="@i">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="AllBill"
                                       asp-route-project="@selectedProject"
                                       asp-route-phase="@selectedPhase"
                                       asp-route-month="@selectedMonth"
                                       asp-route-year="@selectedYear"
                                       asp-route-custNoOrName="@custNoOrName"
                                       asp-route-page="@(Model.PageNumber + 1)"
                                       aria-label="Next">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <form method="get" asp-action="AllBill" asp-controller="Home" class="go-to-page d-inline">
                            <input type="hidden" name="project" value="@selectedProject" />
                            <input type="hidden" name="phase" value="@selectedPhase" />
                            <input type="hidden" name="month" value="@selectedMonth" />
                            <input type="hidden" name="year" value="@selectedYear" />
                            <input type="hidden" name="custNoOrName" value="@custNoOrName" />
                            <label class="mb-0 small text-muted">Go to</label>
                            <input type="number" name="page" min="1" max="@Model.TotalPages" value="@Model.PageNumber" class="form-control form-control-sm" style="width:56px; display:inline-block; padding:4px 6px;" />
                            <button type="submit" class="btn btn-sm btn-secondary">Go</button>
                        </form>
                    </div>
                </div>
            }

            <p class="text-muted small mt-2 mb-0">Double-click a row to open the printable bill in a new tab.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.querySelector('form.filter-section');
            if (!form) return;
            var phaseUrl = '@Url.Action("GetPhasesByProject", "MaintenanceNew")';
            var selectedPhase = '@selectedPhase';

            function loadPhases(project, preselect) {
                var ddl = document.getElementById('phase');
                if (!ddl) return;
                ddl.innerHTML = '';
                ddl.appendChild(new Option('-- All Phases --', ''));
                if (!project) return;

                $.getJSON(phaseUrl, { project: project }, function (items) {
                    if (Array.isArray(items)) {
                        items.forEach(function (v) {
                            ddl.appendChild(new Option(v, v));
                        });
                    }
                    if (preselect) {
                        ddl.value = preselect;
                    }
                });
            }

            var projectDdl = document.getElementById('project');
            if (projectDdl) {
                projectDdl.addEventListener('change', function () {
                    loadPhases(this.value || '', '');
                });
            }

            loadPhases((document.getElementById('project') || {}).value || '', selectedPhase);

            form.addEventListener('submit', function (e) {
                var project = (document.getElementById('project') || {}).value || '';
                var month = (document.getElementById('month') || {}).value || '';
                var year = (document.getElementById('year') || {}).value || '';
                var term = (document.getElementById('custNoOrName') || {}).value || '';
                var hasTerm = term.trim().length > 0;
                var hasAnyFilter = project || month || year;
                var hasAllFilters = project && month && year;

                if (!hasTerm && hasAnyFilter && !hasAllFilters) {
                    e.preventDefault();
                    alert('Please select Project, Billing Month and Billing Year together, or enter BTNo/CustomerName only.');
                }
            });
        })();
    </script>
}
