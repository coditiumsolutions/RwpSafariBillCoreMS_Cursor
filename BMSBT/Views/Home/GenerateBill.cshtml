@model IEnumerable<BMSBT.ViewModels.MaintSectorCustomersViewModel>
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var accordionId = "accordionSectors";
    int count = 0;
    var selectedProject = ViewBag.SelectedProject as string;
    var selectedPhaseName = ViewBag.SelectedPhaseName as string;
    var btNoSearch = ViewBag.BTNoSearch as string;
    var projects = ViewBag.Projects as List<string> ?? new List<string>();
    var phaseNames = ViewBag.PhaseNames as List<string> ?? new List<string>();

    string operatorName = ViewBag.OperatorName as string ?? "";
    string billingMonth = ViewBag.BillingMonth as string ?? "";
    string billingYear = ViewBag.BillingYear as string ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    #loadingOverlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.7);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
    }

    #loadingOverlay .spinner-border {
        width: 3rem;
        height: 3rem;
    }
</style>

<div id="loadingOverlay">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="mb-3">
    <span class="fw-bold text-primary">Operator:</span> @operatorName |
    <span class="fw-bold text-primary">Billing Month:</span> @billingMonth |
    <span class="fw-bold text-primary">Billing Year:</span> @billingYear
</div>

<form method="get" asp-action="GenerateBill" asp-controller="Home">
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label fw-bold">Project</label>
            <select name="selectedProject" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Project --</option>
                @foreach (var project in projects)
                {
                    <option value="@project" selected="@(project == selectedProject)">@project</option>
                }
            </select>
        </div>
        @if (!string.IsNullOrEmpty(selectedProject))
        {
            <div class="col-md-4">
                <label class="form-label fw-bold">Phase Name</label>
                <select name="selectedPhaseName" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Phase Names --</option>
                    @foreach (var sp in phaseNames)
                    {
                        <option value="@sp" selected="@(sp == selectedPhaseName)">@sp</option>
                    }
                </select>
            </div>
        }
        @if (!string.IsNullOrEmpty(selectedProject))
        {
            <div class="col-md-4">
                <label class="form-label fw-bold">Search by BTNo:</label>
                <input type="text" name="btNoSearch" value="@btNoSearch" class="form-control" placeholder="Enter BTNo..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        }
    </div>
    <div class="d-flex gap-2 mb-3">
        <button id="previewMBillButton" type="button" class="btn btn-outline-secondary" style="width:170px">
            Preview (Dry Run)
        </button>
        <button id="generateMBillButton" type="button" class="btn btn-outline-primary" style="width:170px">
            Generate MBill
        </button>
        <button id="initializeCustomersButton" type="button" class="btn btn-outline-warning" style="width:170px">
            Initialise Customers
        </button>
    </div>
</form>

<div id="billingPreviewContainer" class="mt-3"></div>

<div class="accordion" id="@accordionId">
    @foreach (var group in Model)
    {
        var collapseId = $"collapse_{count}";
        var headingId = $"heading_{count}";
        <div class="accordion-item">
            <h2 class="accordion-header" id="@headingId">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                        aria-expanded="false" aria-controls="@collapseId">
                    Category: @group.Block <span class="ms-3 text-muted">(Total: @group.Customers.Count)</span>
                </button>
            </h2>
            <div id="@collapseId" class="accordion-collapse collapse"
                 aria-labelledby="@headingId" data-bs-parent="#@accordionId">
                <div class="accordion-body p-0">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><input type="checkbox" onclick="toggleGroupCheckboxes(this, '@collapseId')" /></th>
                                <th>BT Number</th>
                                <th>Customer Name</th>
                                <th>Project</th>
                                <th>Phase Name</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Bill Status</th>
                                <th>Gen Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in group.Customers)
                            {
                                <tr ondblclick="window.open('@Url.Action("Details", "CustomersMaintenance", new { id = customer.Uid })', '_blank')" style="cursor: pointer;" title="Double-click to open customer record (read-only)">
                                    <td>
                                        <input type="checkbox" name="selectedCustomers"
                                               value="@customer.Uid"
                                               class="record-checkbox checkbox-@collapseId" />
                                    </td>
                                    <td>@customer.BTNo</td>
                                    <td>@customer.CustomerName</td>
                                    <td>@customer.Project</td>
                                    <td>@customer.SubProject</td>
                                    <td>@customer.Category</td>
                                    <td>@customer.Size</td>
                                    <td>@customer.BillStatusMaint</td>
                                    <td>@customer.BillGenerationStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        count++;
    }
</div>

<script>
    function toggleGroupCheckboxes(source, groupId) {
        var selector = '.checkbox-' + groupId;
        var checked = source.checked;
        document.querySelectorAll(selector).forEach(cb => cb.checked = checked);
    }
</script>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var currentProject = "@selectedProject";
        var currentMonth = "@billingMonth";
        var currentYear = "@billingYear";

        $(document).ready(function () {
            function getSelectedIds() {
                return $('.record-checkbox:checked').map(function () {
                    return +this.value;
                }).get();
            }

            function renderPreviewTable(response, dryRun) {
                var $container = $('#billingPreviewContainer');
                $container.empty();

                if (!response || !response.customerLogs || !response.customerLogs.length) {
                    $container.html('<div class="alert alert-info">No preview rows returned.</div>');
                    return;
                }

                var title = dryRun ? 'Dry-Run Preview (No DB Save)' : 'Generation Result Details';
                var html = '<div class="card"><div class="card-header fw-bold">' + title + '</div><div class="card-body p-0">' +
                    '<div class="table-responsive"><table class="table table-sm table-bordered mb-0">' +
                    '<thead><tr>' +
                    '<th>Customer</th><th>Tariff Found</th><th>BillAmount</th><th>TaxAmount</th><th>Current Bill</th><th>Surcharge</th><th>BillInDueDate</th><th>BillAfterDate</th><th>Status</th><th>Reason</th>' +
                    '</tr></thead><tbody>';

                response.customerLogs.forEach(function (x) {
                    var tariffInfo = (x.project || '') + ' / ' + (x.category || '') + ' / ' + (x.size || '');
                    html += '<tr>' +
                        '<td>' + (x.customerName || '') + ' (' + (x.btNo || '') + ')</td>' +
                        '<td>' + tariffInfo + '</td>' +
                        '<td>' + (x.billAmount ?? 0) + '</td>' +
                        '<td>' + (x.taxAmount ?? 0) + '</td>' +
                        '<td>' + (x.currentBillSubtotal ?? x.totalBill ?? x.TotalBill ?? 0) + '</td>' +
                        '<td>' + (x.surcharge ?? 0) + '</td>' +
                        '<td>' + (x.billInDueDate ?? 0) + '</td>' +
                        '<td>' + (x.billAfterDate ?? 0) + '</td>' +
                        '<td>' + (x.status || '') + '</td>' +
                        '<td>' + (x.reason || '') + '</td>' +
                        '</tr>';
                });

                html += '</tbody></table></div></div></div>';
                $container.html(html);
            }

            function runBilling(dryRun) {
                var selectedIds = getSelectedIds();

                if (!selectedIds.length) {
                    alert('No records selected.');
                    return;
                }

                $('#loadingOverlay').show();

                $.ajax({
                    url: '/api/MaintenanceBillInsert/from-customers',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ selectedIds: selectedIds, dryRun: dryRun }),
                    success: function (response) {
                        $('#loadingOverlay').hide();
                        if (response && response.success) {
                            if (!dryRun && response.updates && response.updates.length > 0) {
                                response.updates.forEach(function (update) {
                                    var checkbox = $('.record-checkbox[value="' + update.uid + '"]');
                                    var row = checkbox.closest('tr');
                                    row.find('td:last').text(update.status);
                                    checkbox.prop('checked', false);
                                });
                            }
                            renderPreviewTable(response, dryRun);
                            var message = response.message || 'MBills process completed.';
                            if (response.summary) {
                                var s = response.summary;
                                var lines = [
                                    message,
                                    '',
                                    'Selected: ' + (s.selected ?? 0),
                                    'Matched: ' + (s.matched ?? 0),
                                    'Created: ' + (s.created ?? 0),
                                    'Skipped: ' + (s.skipped ?? 0),
                                    'Failed: ' + (s.failed ?? 0),
                                    'RulesVersion: ' + (s.rulesVersion ?? '1.3')
                                ];

                                if (s.reasons) {
                                    lines.push('', 'Reason-wise:');
                                    Object.keys(s.reasons).forEach(function (k) {
                                        lines.push('- ' + k + ': ' + s.reasons[k]);
                                    });
                                }
                                alert(lines.join('\n'));
                            } else {
                                alert(message);
                            }
                        } else {
                            alert('MBill generation completed, but response was unexpected.');
                        }
                    },
                    error: function (xhr) {
                        $('#loadingOverlay').hide();
                        if (xhr.status === 403) {
                            alert('Unauthorized!');
                            window.location.href = '@Url.Action("AccessDenied", "Login")';
                        } else {
                            var errorMsg = 'An error occurred while generating MBills.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            } else if (xhr.responseText) {
                                try {
                                    var res = JSON.parse(xhr.responseText);
                                    if (res.message) errorMsg = res.message;
                                } catch (e) {}
                            }
                            alert(errorMsg);
                        }
                    }
                });
            }

            function initializeCustomers() {
                var selectedIds = getSelectedIds();

                if (!selectedIds.length) {
                    alert('No records selected.');
                    return;
                }

                if (!confirm('Set Bill Generation Status to Not Generated for selected customers?')) {
                    return;
                }

                $('#loadingOverlay').show();

                $.ajax({
                    url: '@Url.Action("InitializeCustomers", "MaintenanceNew")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ selectedIds: selectedIds })
                }).done(function (response) {
                    if (response && response.success && response.updates) {
                        response.updates.forEach(function (update) {
                            var checkbox = $('.record-checkbox[value="' + update.uid + '"]');
                            var row = checkbox.closest('tr');
                            row.find('td:last').text(update.status || 'Not Generated');
                            checkbox.prop('checked', false);
                        });
                        alert(response.message || 'Customers initialized successfully.');
                    } else {
                        alert((response && response.message) || 'Initialization completed with unexpected response.');
                    }
                }).fail(function (xhr) {
                    var errorMsg = 'Failed to initialize customers.';
                    if (xhr.responseText) {
                        try {
                            var res = JSON.parse(xhr.responseText);
                            if (res.message) errorMsg = res.message;
                        } catch (e) {}
                    }
                    alert(errorMsg);
                }).always(function () {
                    $('#loadingOverlay').hide();
                });
            }

            $('#previewMBillButton').click(function () { runBilling(true); });
            $('#generateMBillButton').click(function () { runBilling(false); });
            $('#initializeCustomersButton').click(function () { initializeCustomers(); });
        });
    </script>
}
