@model IEnumerable<BMSBT.Models.ManualRate>
@{
    ViewData["Title"] = "Manual Rates";
    Layout = "~/Views/Shared/_LayoutSetup.cshtml";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h4>Manual Rates</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-12 text-right">
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Create New
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table id="manualRatesGrid" class="table table-striped table-bordered table-hover" style="width:100%">
                    <thead class="thead-light">
                        <tr>
                            <th>Customer No</th>
                            <th>Phase</th>
                            <th>Size</th>
                            <th>Category</th>
                            <th>Unit Type</th>
                            <th>Misc</th>
                            <th>Tax</th>
                            <th>Maint Charges</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-sno="@item.SNo" style="cursor: pointer;" title="Double-click to open">
                                <td>@item.CustomerNo</td>
                                <td>@item.Phase</td>
                                <td>@(item.Size ?? "—")</td>
                                <td>@item.Category</td>
                                <td>@item.UnitType</td>
                                <td>@item.Misc</td>
                                <td>@item.Tax</td>
                                <td>@item.MaintCharges</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#manualRatesGrid').DataTable({
                "ordering": false,
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "responsive": true,
                "searching": true
            });

            $('#manualRatesGrid tbody').on('dblclick', 'tr', function () {
                var sno = $(this).data('sno');
                if (sno) {
                    window.location.href = '@Url.Action("Details", "ManualRates")/' + sno;
                }
            });
        });
    </script>
}
