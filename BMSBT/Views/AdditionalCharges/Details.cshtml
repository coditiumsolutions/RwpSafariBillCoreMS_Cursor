@model BMSBT.Models.AdditionalCharge
@{
    Layout = "~/Views/Shared/_LayoutAdditionalCharges.cshtml";
    ViewData["Title"] = "Additional Charge Details";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Additional Charge Details</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">UID</dt>
            <dd class="col-sm-9">@Model.Uid</dd>

            <dt class="col-sm-3">BT No</dt>
            <dd class="col-sm-9">@Model.BtNo</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department</dd>

            <dt class="col-sm-3">Service type</dt>
            <dd class="col-sm-9">@Model.ServiceType</dd>

            <dt class="col-sm-3">Charge name</dt>
            <dd class="col-sm-9">@Model.ChargesName</dd>

            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@Model.Amount</dd>

            <dt class="col-sm-3">Frequency</dt>
            <dd class="col-sm-9">@Model.Frequency</dd>

            <dt class="col-sm-3">Month</dt>
            <dd class="col-sm-9">@Model.Month</dd>

            <dt class="col-sm-3">Year</dt>
            <dd class="col-sm-9">@Model.Year</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Uid" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
