@model BMSBT.Models.AdditionalCharge
@{
    Layout = "~/Views/Shared/_LayoutAdditionalCharges.cshtml";
    ViewData["Title"] = "Create Additional Charge";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Create Additional Charge</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_AdditionalChargeFields" model="Model" />
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
