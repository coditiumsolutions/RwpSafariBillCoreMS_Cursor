@model List<BMSBT.ViewModels.OperationsUnpaidRowViewModel>
@{
    ViewData["Title"] = "Disconnections";
    Layout = "~/Views/Shared/_LayoutOperations.cshtml";
    var months = ViewBag.Months as List<string> ?? new List<string>();
    var years = ViewBag.Years as List<string> ?? new List<string>();
    var selectedBillingMonth = ViewBag.SelectedBillingMonth as string ?? "";
    var selectedBillingYear = ViewBag.SelectedBillingYear as string ?? "";
    var currentMonth = ViewBag.CurrentMonth as string ?? "";
    var currentYear = ViewBag.CurrentYear as string ?? "";
}

<div class="card mb-3">
    <div class="card-header"><strong>Disconnections Filters</strong></div>
    <div class="card-body">
        <form method="get" asp-controller="Operations" asp-action="Disconnections">
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label>Billing Month</label>
                    <select name="billingMonth" class="form-control">
                        @foreach (var m in months)
                        {
                            <option value="@m" selected="@(m == selectedBillingMonth)">@m</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-3">
                    <label>Billing Year</label>
                    <select name="billingYear" class="form-control">
                        @foreach (var y in years)
                        {
                            <option value="@y" selected="@(y == selectedBillingYear)">@y</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Show</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Disconnections (Unpaid after due date) - @currentMonth @currentYear</strong>
        <span class="text-muted">Total: @(Model?.Count ?? 0)</span>
    </div>
    <div class="card-body table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="thead-dark">
                <tr>
                    <th>BT No</th>
                    <th>Customer Name</th>
                    <th>Project</th>
                    <th>Phase</th>
                    <th>Due Date</th>
                    <th>Payment Status</th>
                    <th class="text-right">Bill Amount</th>
                    <th class="text-right">Amount Paid</th>
                    <th class="text-right">Outstanding</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.BtNo</td>
                            <td>@row.CustomerName</td>
                            <td>@row.Project</td>
                            <td>@row.Phase</td>
                            <td>@(row.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td>@row.PaymentStatus</td>
                            <td class="text-right">@row.BillAmount.ToString("N0")</td>
                            <td class="text-right">@row.AmountPaid.ToString("N0")</td>
                            <td class="text-right">@row.OutstandingAmount.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">No disconnection candidates found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
