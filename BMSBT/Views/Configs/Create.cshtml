@model BMSBT.Models.Configuration

@{
    ViewData["Title"] = "Create Configuration";
    Layout = "~/Views/Shared/_LayoutSetup.cshtml";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h4>Create New Configuration</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group">
                    <label asp-for="ConfigId" class="control-label"></label>
                    <input asp-for="ConfigId" class="form-control" />
                    <span asp-validation-for="ConfigId" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="ConfigKey" class="control-label"></label>
                    <input asp-for="ConfigKey" class="form-control" maxlength="50" />
                    <span asp-validation-for="ConfigKey" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <label asp-for="ConfigValue" class="control-label"></label>
                    <textarea asp-for="ConfigValue" class="form-control" maxlength="1000" rows="4" placeholder="Enter comma-separated values (e.g. Value1,Value2,Value3)"></textarea>
                    <small class="form-text text-muted">Enter multiple values separated by commas. Maximum 1000 characters.</small>
                    <span asp-validation-for="ConfigValue" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-action="AllConfigs" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
