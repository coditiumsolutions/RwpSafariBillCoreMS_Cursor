<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Billing System</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/SGStyleSheet.css" />
    
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/solid.js" integrity="sha384-tzzSw1/Vo+0N5UhStP3bvwWPq+uvzCMfrN1fEFe+xBmv1C/AtVX5K0uZtmcHitFZ" crossorigin="anonymous"></script>
    <script defer src="https://use.fontawesome.com/releases/v5.0.13/js/fontawesome.js" integrity="sha384-6OIrr52G08NpOFSZdxxz1xdNSndlD4vdcf/q2myIUVO0VsqaGHJsB0RaBE01VTOY" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <style>
        .sidebar {
            position: absolute; /* Allow normal scrolling behavior */
        }

        .navbar2-top {
            background-color: #f8f9fa; /* Light background color */
            padding: 0px 0;
        }
        .navbar2-top .container {
                display: flex;
                justify-content: space-between;
                align-items: center;
        }

        .navbar2-top .left-section {
                font-weight: bold;
        }
        .navbar2-top .right-section {
                text-align: right;
                flex-grow: 1;
        }

            .navbar2-top .left-section a {
                color: #0056b3;
            }

        a {
            text-decoration: none !important;
        }

        .sidebar-divider {
            border-color: #dee2e6;
        }

        .user-info {
            color: #0056b3; /* Dark gray */
            font-size: 16px; /* Reduce font size */
            font-weight: normal;
        }
    </style>

</head>
<body>

    <!-- First Top Bar -->
    <nav class="navbar navbar-expand-lg navbar1-top navbar-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="~/images/logo.png" alt="Logo" class="logo-margin" style="height: 70px; margin-left: 10px;">
            </a>
            <span class="navbar-text text-white">Safari Rawalpindi</span>
        </div>
    </nav>

    <!-- Second Top Bar -->
    <nav class="navbar navbar-expand-lg navbar2-top">
        <div class="container">
            <!-- Left-aligned text -->
            <div class="left-section">
                <a asp-controller="Home" asp-action="Index"> Back Main Menu</a>
            </div>
            <!-- Right-aligned text -->
            <div class="right-section">
                <span class="user-info"> Logged-in as @ViewBag.UserName at @ViewBag.LoginTime </span>
                <a asp-controller="Login" asp-action="Logout"
                   class="btn btn-link text-black"
                   onclick="return confirm('Are you sure you want to log out?');">
                    Logout
                </a>
            </div>
        </div>
    </nav>

    <!-- Third Top Bar -->
    <nav class="navbar navbar-expand-lg navbar3-top">
        <div class="container">
            <span class="navbar-text text-white"></span>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- Left Sidebar -->
            <div class="col-md-3 col-lg-2 p-3 sidebar">
                <h4>Home</h4>


                <ul class="nav flex-column">



                    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ||
                         ViewContext.RouteData.Values["controller"]?.ToString() == "CustomersMaintenance" ||
                         ViewContext.RouteData.Values["controller"]?.ToString() == "MaintenanceBill")
                    {
                        <li>
                            <a asp-controller="Home" asp-action="Dashboard">
                                <i class="fas fa-chart-line" style="color: yellowgreen; font-size: 14px;"></i>
                                Dashboard
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="Customer">
                                <i class="fas fa-user" style="color: yellowgreen; font-size: 14px;"></i>
                                Customer
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="AllBill">
                                <i class='fas fa-money-bill' style="color: yellowgreen; font-size: 14px;"></i>
                                All Bill
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="GenerateBill">
                                <i class='fas fa-bolt' style="color: yellowgreen; font-size: 14px;"></i>
                                Generate Bill
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="PrintBills">
                                <i class="fas fa-print" style="color: yellowgreen; font-size: 14px;"></i>
                                Print Bills
                            </a>
                        </li>

                    }

                    <li class="mt-4">
                        <h4>Modules</h4>
                    </li>

                    <li>
                        <a asp-controller="Setup" asp-action="Index">
                            <i class='fas fa-cog' style="color: yellowgreen; font-size: 14px;"></i>
                            Setups
                        </a>
                    </li>

                    <!-- Twistee with collapsible internal links (BMS Home) -->
                    <li class="nav-item">
                        <a class="nav-link d-flex justify-content-between align-items-center"
                           data-toggle="collapse"
                           href="#twisteeSubMenuBMS"
                           role="button"
                           aria-expanded="false"
                           aria-controls="twisteeSubMenuBMS">
                            <span>
                                <i class="fas fa-cog" style="color: yellowgreen; font-size: 14px;"></i>
                                &nbsp; Other Links
                            </span>
                            <i class="fas fa-chevron-down twistee-caret"></i>
                        </a>

                        <div class="collapse" id="twisteeSubMenuBMS">
                            <ul class="nav flex-column ml-3">
                                @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ||
                                     ViewContext.RouteData.Values["controller"]?.ToString() == "CustomersMaintenance" ||
                                     ViewContext.RouteData.Values["controller"]?.ToString() == "MaintenanceBill")
                                {
                                    <li>
                                        <a asp-controller="Home" asp-action="BillSummary">
                                            <i class="fas fa-chart-bar" style="color: yellowgreen; font-size: 14px;"></i>
                                            Bill Summary
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-controller="MaintenanceBill" asp-action="PaymentForm">
                                            <i class='fas fa-edit' style="color: yellowgreen; font-size: 14px;"></i>
                                            Pay Bill(s)
                                        </a>
                                    </li>
                                }

                                <li>
                                    <a asp-controller="Fine" asp-action="Index">
                                        <i class='fas fa-cog' style="color: yellowgreen; font-size: 14px;"></i>
                                        Fine
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="AdditionalCharges" asp-action="Index">
                                        <i class='fas fa-plus-circle' style="color: yellowgreen; font-size: 14px;"></i>
                                        Additional Charges
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="Adjustments" asp-action="Index">
                                        <i class='fas fa-sliders-h' style="color: yellowgreen; font-size: 14px;"></i>
                                        Adjustments
                                    </a>
                                </li>

                                <li>
                                    <a asp-controller="Reports" asp-action="Index">
                                        <i class='fas fa-chart-pie' style="color: yellowgreen; font-size: 14px;"></i>
                                        Reports
                                    </a>
                                </li>

                                <!-- Add more Twistee internal links here -->

                            </ul>
                        </div>
                    </li>









                  

                    <li>
                        <a asp-controller="Login" asp-action="Logout"
                           onclick="return confirm('Are you sure you want to log out?');">
                            <i class="fas fa-sign-out-alt" style="color: yellowgreen; font-size: 14px;"></i>
                            Exit
                        </a>
                    </li>



                                      
                </ul>
            </div>

            <!-- Right Content Area -->
            <div class="col-md-9 col-lg-10 content-area p-3">
                @RenderBody()
            </div>

        </div>
    </div>

    @RenderSection("Scripts", required: false)
  </body>
</html>
<!-- jQuery (required for Bootstrap 4 JS) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap 4 JS (requires Popper which you already include) -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<!-- caret toggle for Twistee submenu -->
<script>
    $(document).on('show.bs.collapse', '.collapse', function () {
      $(this).prev().find('.twistee-caret').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    });

    $(document).on('hide.bs.collapse', '.collapse', function () {
      $(this).prev().find('.twistee-caret').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });
</script>
