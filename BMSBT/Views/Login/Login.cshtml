
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
}


<script>
    window.history.pushState(null, null, window.location.href);
    window.onpopstate = function () {
        history.go(1);
    };
</script>

<style>
    .login-page-wrapper {
        min-height: calc(100vh - 190px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0.5rem;
        background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-shell {
        width: 100%;
        max-width: 980px;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 22px 45px rgba(15, 23, 42, 0.12);
        animation: fadeInUp 0.6s ease-out both;
    }

    .brand-panel {
        min-height: 560px;
        background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
        color: #e2e8f0;
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand-content {
        max-width: 300px;
        text-align: center;
    }

    .brand-logo {
        width: 172px;
        height: 172px;
        object-fit: contain;
        margin: 0 auto 1rem;
        display: block;
    }

    .brand-title {
        font-size: 1.45rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: #d4af37;
    }

    .brand-text {
        margin-bottom: 0;
        color: #d4af37;
    }

    .form-panel {
        min-height: 560px;
        padding: 1.25rem;
        background: linear-gradient(135deg, #f8fbff 0%, #eef4fb 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 1rem;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
        padding: 2rem 1.5rem;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .login-logo {
        width: 84px;
        height: 84px;
        object-fit: contain;
    }

    .login-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 1.5rem;
    }

    .input-icon-group {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 0.95rem;
        transform: translateY(-50%);
        color: #64748b;
        pointer-events: none;
        z-index: 2;
    }

    .login-input {
        border-radius: 0.65rem;
        padding: 0.7rem 0.9rem 0.7rem 2.6rem;
        border: 1px solid #cbd5e1;
    }

    .login-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
    }

    .btn-login {
        width: 100%;
        border-radius: 0.65rem;
        padding: 0.7rem 1rem;
        background-color: #2563eb;
        border-color: #2563eb;
        font-weight: 600;
    }

    .btn-login:hover {
        background-color: #1d4ed8;
        border-color: #1d4ed8;
    }

    .forgot-link {
        text-decoration: none;
        font-weight: 500;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 991.98px) {
        .form-panel {
            min-height: 0;
            padding: 1rem;
        }

        .login-shell {
            max-width: 460px;
        }
    }

    @@media (max-width: 576px) {
        .login-card {
            padding: 1.5rem 1rem;
        }

        .login-title {
            font-size: 1.2rem;
        }
    }
</style>
<div class="login-page-wrapper">
    <div class="login-shell">
        <div class="row g-0">
            <div class="col-lg-5 d-none d-lg-flex brand-panel">
                <div class="brand-content">
                    <img src="~/images/logo.png" alt="Brand Logo" class="brand-logo" />
                    <h2 class="brand-title">Billing Management</h2>
                    <p class="brand-text">Property of Bahria Town. Authorized users only. All system activities are monitored.</p>
                </div>
            </div>
            <div class="col-lg-7 form-panel">
                <div class="card login-card">
                    <div class="text-center">
                        <h3 class="login-title">Login to Your Account</h3>
                    </div>
                    <form method="post" asp-action="Index">
                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">User Name</label>
                            <div class="input-icon-group">
                                <span class="input-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
                                    </svg>
                                </span>
                                <input type="text" class="form-control login-input" id="username" name="username" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Password</label>
                            <div class="input-icon-group">
                                <span class="input-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 1a3 3 0 0 0-3 3v2H4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-1V4a3 3 0 0 0-3-3Zm2 5H6V4a2 2 0 1 1 4 0v2Z"></path>
                                    </svg>
                                </span>
                                <input type="password" class="form-control login-input" id="password" name="password" required />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
                                <label class="form-check-label" for="rememberMe">Remember Me</label>
                            </div>
                            <a href="#" class="forgot-link">Forgot Password?</a>
                        </div>
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger mt-2">@ViewBag.Error</div>
                        }
                        <button type="submit" class="btn btn-primary btn-login mt-2">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
