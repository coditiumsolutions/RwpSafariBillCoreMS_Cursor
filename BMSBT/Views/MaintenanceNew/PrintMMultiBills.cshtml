@using System.Globalization
@{
    Layout = "~/Views/Shared/_LayoutMaintBills.cshtml";
}

<div id="loadingOverlay" class="loading-overlay" style="display:none;">
    <div class="loading-spinner"></div>
    <div class="loading-text">Processing...</div>
</div>

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #3498db;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .loading-text {
        color: #fff;
        margin-top: 20px;
        font-weight: bold;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

</style>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form id="filterForm" method="post" asp-action="PrintMMultiBills" asp-controller="MaintenanceNew">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Project</label>
            <select id="Project" name="project" class="form-control" required>
                <option value="">-- Select Project --</option>
                @foreach (var project in (List<string>)ViewBag.Projects)
                {
                    <option value="@project">@project</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">SubProject</label>
            <select id="SubProject" name="subProject" class="form-control">
                <option value="">-- Select SubProject --</option>
                @foreach (var sp in (List<string>)ViewBag.SubProjects)
                {
                    <option value="@sp">@sp</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Billing Month</label>
            <select id="month" name="month" class="form-control" required>
                <option value="">-- Month --</option>
                @foreach (var name in CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12))
                {
                    if (!string.IsNullOrEmpty(name))
                    {
                        <option value="@name">@name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Billing Year</label>
            <select id="year" name="year" class="form-control" required>
                <option value="">-- Year --</option>
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 10; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button id="PrintButton" type="button" class="btn btn-primary">Print</button>
        </div>
    </div>
</form>

<p class="text-muted mt-3">Select <strong>Project</strong>, <strong>SubProject</strong> (optional), <strong>Billing Month</strong> and <strong>Billing Year</strong>, then click <strong>Print</strong> to generate the maintenance bills report (PDF).</p>

@section Scripts {
    <script>
            $(function(){
              $('#PrintButton').click(function(){
                var project = $('#Project').val();
                var subProject = $('#SubProject').val();
                var month = $('#month').val();
                var year = $('#year').val();
                if (!project || !month || !year) {
                    alert('Please select Project, Billing Month and Billing Year.');
                    return;
                }
                var data = {
                    project: project,
                    subProject: subProject,
                    month: month,
                    year: year
                };

                $('#loadingOverlay').show();

                $.ajax({
                    url: '@Url.Action("PrintMMultiBills", "MaintenanceNew")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    xhrFields: { responseType: 'blob' }
                }).done(function(responseData) {
                    var blob = new Blob([responseData], { type: 'application/pdf' });
                    var url = URL.createObjectURL(blob);
                    window.open(url);
                }).fail(function(xhr) {
                    var msg = xhr.responseText || 'Print failed';
                    if (xhr.responseType === 'blob' && xhr.response) {
                        var reader = new FileReader();
                        reader.onload = function() { alert(reader.result); };
                        reader.readAsText(xhr.response);
                    } else {
                        alert(msg);
                    }
                }).always(function() {
                    $('#loadingOverlay').hide();
                });
              });
            });
    </script>
}