@using X.PagedList.Mvc.Core
@using X.PagedList
@model IPagedList<BMSBT.Models.CustomersMaintenance>

<style>
    .cm-table-wrap {
        border: 1px solid #d9d9d9;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.08);
    }

    .cm-detail-table.cm-customers-grid-table {
        margin: 0;
    }

    .cm-detail-table.cm-customers-grid-table thead th {
        background: #00bfff;
        color: #000000;
        border-color: #d9d9d9;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .cm-detail-table.cm-customers-grid-table td {
        border-color: #dddddd;
        color: #2c3e50;
        vertical-align: middle;
    }

    .cm-detail-table.cm-customers-grid-table tbody tr:nth-child(odd) {
        background-color: #fffbe6;
    }

    .cm-detail-table.cm-customers-grid-table tbody tr:nth-child(even) {
        background-color: #ffffff;
    }

    .cm-detail-table.cm-customers-grid-table tbody tr:hover {
        background-color: #dff9fb;
    }

    .cm-grid-pager {
        border-top: 1px solid #e1e1e1;
        background: #ffffff;
        padding: 0.75rem 1rem 1rem;
    }

    .cm-grid-pager .pagination {
        margin-bottom: 0;
    }
</style>

<input type="hidden" id="maintCustomerTotalMeta" value="@Model.TotalItemCount" />

<div class="cm-table-wrap">
    <div class="table-responsive">
        <table class="table cm-detail-table cm-customers-grid-table" id="customersTable">
            <thead>
                <tr>
                    <th><i class="fas fa-barcode mr-1"></i> BT No</th>
                    <th><i class="fas fa-user mr-1"></i> Customer Name</th>
                    <th><i class="fas fa-home mr-1"></i> Plot No</th>
                    <th><i class="fas fa-th-large mr-1"></i> Phase</th>
                    <th><i class="fas fa-tags mr-1"></i> Category</th>
                    <th><i class="fas fa-ruler-combined mr-1"></i> Size</th>
                    <th><i class="fas fa-building mr-1"></i> Project</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-id="@item.Uid" style="cursor: pointer;">
                        <td>@item.BTNo</td>
                        <td>@item.CustomerName</td>
                        <td>@item.PloNo</td>
                        <td>@item.SubProject</td>
                        <td>@item.Category</td>
                        <td>@item.Size</td>
                        <td>@item.Project</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cm-grid-pager d-flex justify-content-between align-items-center flex-wrap">
        <small class="text-muted mb-2 mb-md-0">
            @if (Model.TotalItemCount > 0)
            {
                <span>Showing page @Model.PageNumber of @Model.PageCount (@Model.TotalItemCount total)</span>
            }
        </small>
        @Html.PagedListPager(Model, page => Url.Action("FilterCustomers", new { page }),
            new X.PagedList.Mvc.Core.PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                DisplayPageCountAndCurrentLocation = true,
                UlElementClasses = new[] { "pagination" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
    </div>
</div>

