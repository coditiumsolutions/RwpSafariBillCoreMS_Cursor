@model MaintenanceBill

<style>
    .invoice-container {
        max-width: 1000px;
        margin: 0 auto;
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        font-family: Arial, sans-serif;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .invoice-header {
        text-align: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #007bff;
    }

        .invoice-header h2 {
            margin: 0;
            font-size: 24px;
            color: #007bff;
        }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        margin-top: 20px;
        border: 1px solid #dee2e6;
    }

    .details-grid .cell {
        border: 1px solid #dee2e6;
        padding: 10px 12px;
    }

    .details-grid .label {
        font-weight: bold;
        color: #333;
        background-color: #f8f9fa;
    }

    .details-grid .cell.summary-row {
        font-weight: 600;
    }

    .invoice-footer {
        margin-top: 30px;
        text-align: center;
    }

    .btn-secondary {
        background-color: #007bff;
        border: none;
        color: white;
        padding: 10px 20px;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #0056b3;
        }
</style>

<div class="invoice-container">
    <div class="invoice-header">
        <h2>Maintenance Bill</h2>
        <p><strong>Invoice No:</strong> @Model.InvoiceNo</p>
    </div>

    <div class="details-grid">
        <div class="cell label">Invoice No</div><div class="cell">@Model.InvoiceNo</div>
        <div class="cell label">Customer No</div><div class="cell">@Model.CustomerNo</div>
        <div class="cell label">Customer Name</div><div class="cell">@Model.CustomerName</div>
        <div class="cell label">BT No</div><div class="cell">@Model.Btno</div>
        <div class="cell label">Plot Status</div><div class="cell">@Model.PlotStatus</div>
        <div class="cell label">Meter No</div><div class="cell">@Model.MeterNo</div>
        <div class="cell label">Billing Month</div><div class="cell">@Model.BillingMonth</div>
        <div class="cell label">Billing Year</div><div class="cell">@Model.BillingYear</div>
        <div class="cell label">Billing Date</div><div class="cell">@Model.BillingDate?.ToString("dd-MM-yyyy")</div>
        <div class="cell label">Issue Date</div><div class="cell">@Model.IssueDate?.ToString("dd-MM-yyyy")</div>
        <div class="cell label">Due Date</div><div class="cell">@Model.DueDate?.ToString("dd-MM-yyyy")</div>
        <div class="cell label">Valid Date</div><div class="cell">@Model.ValidDate?.ToString("dd-MM-yyyy")</div>
        <div class="cell label">Payment Status</div><div class="cell">@Model.PaymentStatus</div>
        <div class="cell label">Payment Date</div><div class="cell">@Model.PaymentDate?.ToString("dd-MM-yyyy")</div>
        <div class="cell label">Payment Method</div><div class="cell">@Model.PaymentMethod</div>
        <div class="cell label">Bank Detail</div><div class="cell">@Model.BankDetail</div>
        <div class="cell label">Maintenance Charges</div><div class="cell">@Model.MaintCharges?.ToString("N2")</div>
        <div class="cell label">Arrears</div><div class="cell">@Model.Arrears?.ToString("N2")</div>
        <div class="cell label">Tax Amount</div><div class="cell">@Model.TaxAmount?.ToString("N2")</div>
        <div class="cell label">Bill Amount (Due Date)</div><div class="cell">@Model.BillAmountInDueDate?.ToString("N2")</div>
        <div class="cell label">Bill Surcharge</div><div class="cell">@Model.BillSurcharge?.ToString("N2")</div>
        <div class="cell label">Bill Amount (After Due)</div><div class="cell">@Model.BillAmountAfterDueDate?.ToString("N2")</div>
        <div class="cell label">Fine</div><div class="cell">@Model.Fine?.ToString("N2")</div>
        <div class="cell label">Other Charges</div><div class="cell">@Model.OtherCharges?.ToString("N2")</div>
        <div class="cell label">Water Charges</div><div class="cell">@Model.WaterCharges?.ToString("N2")</div>
        <div class="cell label">Last Updated</div><div class="cell">@Model.LastUpdated?.ToString("dd-MM-yyyy HH:mm:ss")</div>
        <div class="cell label">History</div><div class="cell" style="grid-column: span 3;">@Model.History</div>
        <div class="cell label summary-row">G. Total Rs</div><div class="cell summary-row">@(Model.BillAmountInDueDate?.ToString("N2") ?? "0.00")</div>
        <div class="cell label summary-row">Amount Payable within due Date Rs</div><div class="cell summary-row">@(Model.BillAmountInDueDate?.ToString("N2") ?? "0.00")</div>
        <div class="cell label summary-row">Surcharge Rs</div><div class="cell summary-row">@(Model.BillSurcharge?.ToString("N2") ?? "0.00")</div>
        <div class="cell label summary-row">Amount Payable after due date Rs</div><div class="cell summary-row">@(Model.BillAmountAfterDueDate?.ToString("N2") ?? "0.00")</div>
    </div>

    <div class="invoice-footer">
        <a href="@Url.Action("SearchBill", "MaintenanceNew")" class="btn-secondary">Back to Search Results</a>
    </div>
</div>
