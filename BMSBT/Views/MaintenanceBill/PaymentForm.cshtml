@model BMSBT.DTO.BillViewModel
@using System.Collections.Generic
@using System.Globalization

@{
    ViewData["Title"] = "Pay maintenance bill";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var bankBranches = ViewBag.BankBranches as List<string> ?? new List<string>();
    var statusDisplay = Model.CurrentPaymentStatus;
    if (string.IsNullOrWhiteSpace(statusDisplay))
    {
        statusDisplay = "—";
    }
    var statusKey = (Model.CurrentPaymentStatus ?? "").Trim().ToLowerInvariant();
    string badgeClass = "badge-secondary";
    if (statusKey == "paid") { badgeClass = "badge-success"; }
    else if (statusKey == "unpaid" || statusKey == "partially paid") { badgeClass = "badge-warning"; }
    else if (statusKey.Contains("surcharge")) { badgeClass = "badge-info"; }
}

<div class="card shadow-lg payment-workbench">
    <div style="background-color:#101f63; color:white; height:45px;">
        <h3 class="mb-0" style="margin-left:15px; margin-top:5px;">Payment Bill(s)</h3>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()

        <p class="text-muted small mb-3 mb-md-2">
            <strong>Shortcuts:</strong> Enter = look up bill · Ctrl+Enter = save status · Esc = clear tracking no.
 Default billing period comes from operator setup (fields below are editable if needed).
        </p>

        <div class="form-row">
            <div class="form-group col-md-2 col-6">
                <label asp-for="BillingMonth">Billing month</label>
                <select asp-for="BillingMonth" class="form-control form-control-sm" id="pfBillingMonth">
                    @for (var mi = 1; mi <= 12; mi++)
                    {
                        var monthName = CultureInfo.GetCultureInfo("en-US").DateTimeFormat.GetMonthName(mi);
                        <option value="@monthName">@monthName</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-2 col-6">
                <label asp-for="BillingYear">Billing year</label>
                <select asp-for="BillingYear" class="form-control form-control-sm" id="pfBillingYear">
                    @{
                        var currentYearVal = Model.BillingYear?.Trim();
                        if (!string.IsNullOrEmpty(currentYearVal) && currentYearVal != "2025" && currentYearVal != "2026")
                        {
                            <option value="@currentYearVal">@currentYearVal</option>
                        }
                    }
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                </select>
            </div>
            <div class="form-group col-md-2 col-6">
                <label asp-for="PaidOn">Paid on</label>
                <input asp-for="PaidOn" type="date" class="form-control form-control-sm" id="pfPaidOn" />
            </div>
            <div class="form-group col-md-3 col-6">
                <label asp-for="BankBranch">Bank / branch</label>
                <select asp-for="BankBranch" class="form-control form-control-sm" id="pfBankBranch">
                    <option value="">-- Select bank / branch --</option>
                    @foreach (var b in bankBranches)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3 col-12">
                <label asp-for="PaymentType"><strong>Set status to</strong></label>
                <select asp-for="PaymentType" class="form-control form-control-sm" id="pfPaymentType">
                    <option value="Paid">Paid</option>
                    <option value="Paid with surcharge">Paid with surcharge</option>
                    <option value="Unpaid">Unpaid</option>
                </select>
            </div>
        </div>

        <div class="form-row align-items-end">
            <div class="form-group col-md-4 col-12">
                <label asp-for="Btno"><strong>Tracking no. (BTNo)</strong></label>
                <input asp-for="Btno" class="form-control form-control-lg" id="pfBtno" placeholder="Scan or type, then Enter" autocomplete="off" />
            </div>
            <div class="form-group col-md-8 col-12 mb-md-3">
                <button type="button" class="btn btn-success mr-2" id="btnLookup">Look up</button>
                <button type="button" class="btn btn-primary" id="btnApply">Save status</button>
                <span id="pfBusy" class="ml-2 small text-muted" style="display:none;">Working…</span>
            </div>
        </div>

        <div class="mb-3">
            <button type="button" class="btn btn-outline-primary" id="btnPayByExcelToggle">Pay By Excel</button>
        </div>

        <div class="card border-secondary mb-3" id="pfExcelCard" style="display:none;">
            <div class="card-header py-2">
                <strong>Excel Payment Upload</strong>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label for="pfExcelFile">Excel file (.xlsx)</label>
                        <input type="file" class="form-control-file" id="pfExcelFile" accept=".xlsx" />
                    </div>
                    <div class="form-group col-md-2">
                        <label for="pfStartRow">Start Row Number</label>
                        <input type="number" min="1" class="form-control" id="pfStartRow" placeholder="e.g. 5" />
                    </div>
                    <div class="form-group col-md-2">
                        <label for="pfEndRow">End Row Number</label>
                        <input type="number" min="1" class="form-control" id="pfEndRow" placeholder="e.g. 10" />
                    </div>
                    <div class="form-group col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-primary w-100" id="btnPayByExcelSubmit">Submit</button>
                    </div>
                </div>
                <div id="pfExcelResult" class="small" aria-live="polite"></div>
            </div>
        </div>

        <div class="card border-info mb-3" id="pfSummaryCard">
            <div class="card-body py-3">
                <div class="row">
                    <div class="col-md-4">
                        <div class="small text-muted">Current bill status</div>
                        <div class="mt-1">
                            <span id="pfStatusBadge" class="badge @badgeClass badge-pill" style="font-size:0.95rem;">@statusDisplay</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Customer</div>
                        <div id="pfCustomerName" class="font-weight-bold">@(Model.CustomerName ?? "—")</div>
                        <div class="small"><span class="text-muted">Ref:</span> <span id="pfRef">@(Model.ReferenceNumber ?? "—")</span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Amounts (PKR)</div>
                        <div class="small">In due date: <strong id="pfAmtDue">@(Model.BillAmountInDueDate?.ToString() ?? "—")</strong></div>
                        <div class="small">Surcharge: <strong id="pfSurcharge">@(Model.BillSurcharge?.ToString() ?? "—")</strong></div>
                        <div class="small">After due: <strong id="pfAmtAfter">@(Model.BillAmountAfterDueDate?.ToString() ?? "—")</strong></div>
                    </div>
                </div>
                <div id="pfFlash" class="small mt-2 font-weight-bold" aria-live="polite"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    (function () {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        function $(id) { return document.getElementById(id); }

        function isApiSuccess(data) {
            return data && (data.success === true || data.Success === true);
        }

        function apiMessage(data) {
            if (!data) return '';
            return data.message || data.Message || '';
        }

        function paymentStatusFromApi(data) {
            return data.paymentStatus || data.PaymentStatus || '';
        }

        function pickStr(data, camel, pascal) {
            if (!data) return '';
            var v = data[camel];
            if (v !== undefined && v !== null && String(v) !== '') return String(v);
            v = data[pascal];
            return (v === undefined || v === null) ? '' : String(v);
        }

        function pickNumOrDash(data, camel, pascal) {
            var v = data[camel];
            if (v !== undefined && v !== null && v !== '') return v;
            v = data[pascal];
            return (v !== undefined && v !== null && v !== '') ? v : '—';
        }

        function readJsonResponse(res) {
            var ct = (res.headers.get('content-type') || '').toLowerCase();
            if (!res.ok) {
                return res.text().then(function (t) {
                    var snippet = (t || '').replace(/<[^>]+>/g, ' ').trim().substring(0, 180);
                    throw new Error('Request failed (' + res.status + ')' + (snippet ? ': ' + snippet : ''));
                });
            }
            if (ct.indexOf('application/json') < 0) {
                return res.text().then(function () {
                    throw new Error('Server did not return JSON (check login or network).');
                });
            }
            return res.json();
        }

        function setBusy(on) {
            var el = $('pfBusy');
            if (el) el.style.display = on ? 'inline' : 'none';
        }

        function flash(msg, isError) {
            var el = $('pfFlash');
            if (!el) return;
            el.textContent = msg || '';
            el.style.color = isError ? '#c0392b' : '#1e8449';
        }

        function updateSummary(data) {
            var badge = $('pfStatusBadge');
            var st = pickStr(data, 'paymentStatus', 'PaymentStatus') || '—';
            badge.textContent = st;
            badge.className = 'badge badge-pill';
            var k = st.toLowerCase();
            if (k === 'paid') badge.classList.add('badge-success');
            else if (k === 'unpaid' || k.indexOf('partial') >= 0) badge.classList.add('badge-warning');
            else if (k.indexOf('surcharge') >= 0) badge.classList.add('badge-info');
            else badge.classList.add('badge-secondary');

            $('pfCustomerName').textContent = pickStr(data, 'customerName', 'CustomerName') || '—';
            $('pfRef').textContent = pickStr(data, 'referenceNumber', 'ReferenceNumber') || '—';
            $('pfAmtDue').textContent = pickNumOrDash(data, 'billAmountInDueDate', 'BillAmountInDueDate');
            $('pfSurcharge').textContent = pickNumOrDash(data, 'billSurcharge', 'BillSurcharge');
            $('pfAmtAfter').textContent = pickNumOrDash(data, 'billAmountAfterDueDate', 'BillAmountAfterDueDate');
        }

        function getFormState() {
            return {
                btno: ($('pfBtno').value || '').trim(),
                billingMonth: ($('pfBillingMonth').value || '').trim(),
                billingYear: ($('pfBillingYear').value || '').trim(),
                paidOn: $('pfPaidOn').value || '',
                bankBranch: $('pfBankBranch').value || '',
                paymentType: $('pfPaymentType').value || 'Paid'
            };
        }

        function doLookup() {
            var s = getFormState();
            if (!s.btno) {
                flash('Enter a tracking number first.', true);
                $('pfBtno').focus();
                return;
            }
            if (!s.billingMonth || !s.billingYear) {
                flash('Choose billing month and billing year.', true);
                return;
            }
            setBusy(true);
            flash('');
            var url = '@Url.Action("QuickPaymentLookup", "MaintenanceBill")'
                + '?btno=' + encodeURIComponent(s.btno)
                + '&billingMonth=' + encodeURIComponent(s.billingMonth)
                + '&billingYear=' + encodeURIComponent(s.billingYear);
            fetch(url, { credentials: 'same-origin' })
                .then(readJsonResponse)
                .then(function (data) {
                    setBusy(false);
                    if (!isApiSuccess(data)) {
                        flash(apiMessage(data) || 'Lookup failed.', true);
                        return;
                    }
                    updateSummary(data);
                    flash('Bill loaded. Change status if needed, then press Save status (or Ctrl+Enter).', false);
                })
                .catch(function (err) {
                    setBusy(false);
                    flash(err && err.message ? err.message : 'Network error during lookup.', true);
                });
        }

        function doApply() {
            var s = getFormState();
            if (!s.btno || !s.billingMonth || !s.billingYear) {
                flash('Enter tracking number and choose billing month and year.', true);
                return;
            }
            setBusy(true);
            flash('');
            var body = new URLSearchParams();
            body.append('Btno', s.btno);
            body.append('BillingMonth', s.billingMonth);
            body.append('BillingYear', s.billingYear);
            body.append('PaymentType', s.paymentType);
            body.append('BankBranch', s.bankBranch);
            if (s.paidOn) body.append('PaidOn', s.paidOn);
            body.append('__RequestVerificationToken', token);

            fetch('@Url.Action("QuickPaymentApply", "MaintenanceBill")', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: body.toString()
            })
                .then(readJsonResponse)
                .then(function (data) {
                    setBusy(false);
                    if (!isApiSuccess(data)) {
                        var m = apiMessage(data) || 'Save failed.';
                        flash(m, true);
                        Swal.fire({ icon: 'error', title: m, timer: 2500, showConfirmButton: false });
                        return;
                    }
                    updateSummary(data);
                    var okMsg = apiMessage(data) || 'Saved.';
                    flash(okMsg, false);
                    Swal.fire({ icon: 'success', title: okMsg, timer: 1200, showConfirmButton: false });
                    $('pfBtno').value = '';
                    $('pfBtno').focus();
                })
                .catch(function (err) {
                    setBusy(false);
                    flash(err && err.message ? err.message : 'Network error during save.', true);
                });
        }

        var btnLookup = $('btnLookup');
        var btnApply = $('btnApply');
        var pfBtno = $('pfBtno');
        var btnPayByExcelToggle = $('btnPayByExcelToggle');
        var btnPayByExcelSubmit = $('btnPayByExcelSubmit');
        var excelCard = $('pfExcelCard');

        function renderExcelResult(data) {
            var host = $('pfExcelResult');
            if (!host) return;

            if (!isApiSuccess(data)) {
                host.className = 'small text-danger';
                host.textContent = apiMessage(data) || 'Excel processing failed.';
                return;
            }

            var total = data.totalProcessedRows || data.TotalProcessedRows || 0;
            var ok = data.successfullyUpdatedRecords || data.SuccessfullyUpdatedRecords || 0;
            var failed = data.failedOrNotFoundRecords || data.FailedOrNotFoundRecords || 0;
            var missing = data.missingRecords || data.MissingRecords || [];

            var html = '<div class="alert alert-success py-2 mb-2">'
                + '<strong>Processed:</strong> ' + total
                + ' | <strong>Updated:</strong> ' + ok
                + ' | <strong>Failed/Not Found:</strong> ' + failed
                + '</div>';

            if (missing && missing.length) {
                html += '<div class="alert alert-warning py-2 mb-0"><div><strong>Missing / failed rows:</strong></div><ul class="mb-0 pl-3">';
                for (var i = 0; i < missing.length; i++) {
                    var m = missing[i] || {};
                    html += '<li>Row ' + (m.rowNumber || m.RowNumber || 'N/A')
                        + ' | BTNo: ' + (m.btno || m.Btno || '-')
                        + ' | Month: ' + (m.billingMonth || m.BillingMonth || '-')
                        + ' | Year: ' + (m.billingYear || m.BillingYear || '-')
                        + ' | Reason: ' + (m.reason || m.Reason || 'Not found')
                        + '</li>';
                }
                html += '</ul></div>';
            }

            host.className = 'small';
            host.innerHTML = html;
        }

        function doExcelPay() {
            var fileInput = $('pfExcelFile');
            var startRowInput = $('pfStartRow');
            var endRowInput = $('pfEndRow');

            var file = fileInput && fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
            var startRow = startRowInput ? parseInt(startRowInput.value || '0', 10) : 0;
            var endRow = endRowInput ? parseInt(endRowInput.value || '0', 10) : 0;

            if (!file) {
                renderExcelResult({ success: false, message: 'Please choose an Excel file first.' });
                return;
            }
            if (!file.name || file.name.toLowerCase().indexOf('.xlsx') < 0) {
                renderExcelResult({ success: false, message: 'Only .xlsx files are allowed.' });
                return;
            }
            if (!startRow || !endRow || startRow <= 0 || endRow <= 0) {
                renderExcelResult({ success: false, message: 'Enter valid start and end row numbers.' });
                return;
            }
            if (startRow > endRow) {
                renderExcelResult({ success: false, message: 'Start row number cannot be greater than end row number.' });
                return;
            }

            setBusy(true);
            var host = $('pfExcelResult');
            if (host) {
                host.className = 'small text-muted';
                host.textContent = 'Processing Excel rows...';
            }

            var body = new FormData();
            body.append('ExcelFile', file);
            body.append('StartRowNumber', String(startRow));
            body.append('EndRowNumber', String(endRow));
            body.append('__RequestVerificationToken', token);

            fetch('@Url.Action("PayByExcel", "MaintenanceBill")', {
                method: 'POST',
                credentials: 'same-origin',
                body: body
            })
                .then(readJsonResponse)
                .then(function (data) {
                    setBusy(false);
                    renderExcelResult(data);
                    if (isApiSuccess(data)) {
                        Swal.fire({ icon: 'success', title: 'Excel processed successfully', timer: 1400, showConfirmButton: false });
                    } else {
                        Swal.fire({ icon: 'error', title: apiMessage(data) || 'Excel processing failed', timer: 2400, showConfirmButton: false });
                    }
                })
                .catch(function (err) {
                    setBusy(false);
                    renderExcelResult({ success: false, message: err && err.message ? err.message : 'Network error during Excel processing.' });
                });
        }

        if (btnLookup) btnLookup.addEventListener('click', doLookup);
        if (btnApply) btnApply.addEventListener('click', doApply);
        if (btnPayByExcelToggle && excelCard) {
            btnPayByExcelToggle.addEventListener('click', function () {
                var open = excelCard.style.display !== 'none';
                excelCard.style.display = open ? 'none' : 'block';
            });
        }
        if (btnPayByExcelSubmit) btnPayByExcelSubmit.addEventListener('click', doExcelPay);

        if (pfBtno) pfBtno.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                doLookup();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                var b = $('pfBtno');
                if (b) { b.value = ''; b.focus(); }
            }
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                doApply();
            }
        });

        if (pfBtno) pfBtno.focus();
    })();
</script>
