@model List<BMSBT.ViewModels.RecoverySummaryViewModel>
@{
    ViewData["Title"] = "Recovery";
    Layout = "~/Views/Shared/_LayoutReports.cshtml";
    var months = ViewBag.Months as List<string> ?? new List<string>();
    var years = ViewBag.Years as List<string> ?? new List<string>();
    var projects = ViewBag.Projects as List<string> ?? new List<string>();
    var phases = ViewBag.Phases as List<string> ?? new List<string>();
    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
    var selectedProject = ViewBag.SelectedProject as string ?? "";
    var selectedPhase = ViewBag.SelectedPhase as string ?? "";
    var totalBills = Model?.Sum(x => x.TotalBills) ?? 0;
    var paidBills = Model?.Sum(x => x.PaidBills) ?? 0;
    var unpaidBills = Model?.Sum(x => x.UnpaidBills) ?? 0;
    var maintenanceCharges = Model?.Sum(x => x.MaintenanceCharges) ?? 0m;
    var miscCharges = Model?.Sum(x => x.MiscCharges) ?? 0m;
    var miscPaid = Model?.Sum(x => x.MiscPaid) ?? 0m;
    var waterCharges = Model?.Sum(x => x.WaterCharges) ?? 0m;
    var rentCharges = Model?.Sum(x => x.RentCharges) ?? 0m;
    var extraCharges = Model?.Sum(x => x.ExtraCharges) ?? 0m;
    var otherCharges = Model?.Sum(x => x.OtherCharges) ?? 0m;
    var arrears = Model?.Sum(x => x.Arrears) ?? 0m;
    var payableAmount = Model?.Sum(x => x.PayableAmount) ?? 0m;
    var amountPaid = Model?.Sum(x => x.AmountPaid) ?? 0m;
    var installmentPaid = Model?.Sum(x => x.InstallmentPaid) ?? 0m;
    var advanceAmount = Model?.Sum(x => x.AdvanceAmount) ?? 0m;
}

<div class="card mb-3">
    <div class="card-header"><strong>Recovery Filters</strong></div>
    <div class="card-body">
        <form method="get" asp-controller="Reports" asp-action="Recovery">
            <div class="form-row">
                <div class="form-group col-md-2">
                    <label>Billing Month</label>
                    <select name="month" class="form-control">
                        @foreach (var m in months)
                        {
                            <option value="@m" selected="@(m == selectedMonth)">@m</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-2">
                    <label>Billing Year</label>
                    <select name="year" class="form-control">
                        @foreach (var y in years)
                        {
                            <option value="@y" selected="@(y == selectedYear)">@y</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-3">
                    <label>Project</label>
                    <select name="project" class="form-control">
                        <option value="">-- All Projects --</option>
                        @foreach (var p in projects)
                        {
                            <option value="@p" selected="@(p == selectedProject)">@p</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-3">
                    <label>Phase</label>
                    <select name="phase" class="form-control">
                        <option value="">-- All Phases --</option>
                        @foreach (var p in phases)
                        {
                            <option value="@p" selected="@(p == selectedPhase)">@p</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Show</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Recovery Summary</strong></div>
    <div class="card-body table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="thead-dark">
                <tr>
                    <th>Phase</th>
                    <th class="text-right">Total Bills (No of Bills)</th>
                    <th class="text-right">Paid Bills (No of Bills)</th>
                    <th class="text-right">Unpaid Bills</th>
                    <th class="text-right">Maintenance Charges</th>
                    <th class="text-right">Misc Charges</th>
                    <th class="text-right">Misc Paid</th>
                    <th class="text-right">Water Charges</th>
                    <th class="text-right">Rent Charges</th>
                    <th class="text-right">Extra Charges</th>
                    <th class="text-right">Other Charges</th>
                    <th class="text-right">Arrears</th>
                    <th class="text-right">Payable Amount</th>
                    <th class="text-right">Amount Paid</th>
                    <th class="text-right">Installment Paid</th>
                    <th class="text-right">Advane Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.Phase</td>
                            <td class="text-right">@row.TotalBills</td>
                            <td class="text-right">@row.PaidBills</td>
                            <td class="text-right">@row.UnpaidBills</td>
                            <td class="text-right">@row.MaintenanceCharges.ToString("N0")</td>
                            <td class="text-right">@row.MiscCharges.ToString("N0")</td>
                            <td class="text-right">@row.MiscPaid.ToString("N0")</td>
                            <td class="text-right">@row.WaterCharges.ToString("N0")</td>
                            <td class="text-right">@row.RentCharges.ToString("N0")</td>
                            <td class="text-right">@row.ExtraCharges.ToString("N0")</td>
                            <td class="text-right">@row.OtherCharges.ToString("N0")</td>
                            <td class="text-right">@row.Arrears.ToString("N0")</td>
                            <td class="text-right">@row.PayableAmount.ToString("N0")</td>
                            <td class="text-right">@row.AmountPaid.ToString("N0")</td>
                            <td class="text-right">@row.InstallmentPaid.ToString("N0")</td>
                            <td class="text-right">@row.AdvanceAmount.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="16" class="text-center text-muted">No phases found for selected criteria.</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="font-weight-bold">
                    <td>Total</td>
                    <td class="text-right">@totalBills</td>
                    <td class="text-right">@paidBills</td>
                    <td class="text-right">@unpaidBills</td>
                    <td class="text-right">@maintenanceCharges.ToString("N0")</td>
                    <td class="text-right">@miscCharges.ToString("N0")</td>
                    <td class="text-right">@miscPaid.ToString("N0")</td>
                    <td class="text-right">@waterCharges.ToString("N0")</td>
                    <td class="text-right">@rentCharges.ToString("N0")</td>
                    <td class="text-right">@extraCharges.ToString("N0")</td>
                    <td class="text-right">@otherCharges.ToString("N0")</td>
                    <td class="text-right">@arrears.ToString("N0")</td>
                    <td class="text-right">@payableAmount.ToString("N0")</td>
                    <td class="text-right">@amountPaid.ToString("N0")</td>
                    <td class="text-right">@installmentPaid.ToString("N0")</td>
                    <td class="text-right">@advanceAmount.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
