@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_LayoutReports.cshtml";

    var months = ViewBag.Months as List<string> ?? new List<string>();
    var years = ViewBag.Years as List<string> ?? new List<string>();
    var projects = ViewBag.Projects as List<string> ?? new List<string>();

    var selectedMonth = ViewBag.SelectedMonth as string ?? "";
    var selectedYear = ViewBag.SelectedYear as string ?? "";
    var selectedProject = ViewBag.SelectedProject as string ?? "";

    decimal totalBillsAmount = ViewBag.TotalBillsAmount is decimal tba ? tba : 0m;
    decimal totalPaidAmount = ViewBag.TotalPaidAmount is decimal tpa ? tpa : 0m;
    decimal totalUnpaidAmount = ViewBag.TotalUnpaidAmount is decimal tua ? tua : 0m;
}

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Reports Filters</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" asp-controller="Reports">
            <div class="form-row">
                <div class="form-group col-md-3">
                    <label class="font-weight-bold">Month</label>
                    <select name="month" class="form-control">
                        @foreach (var month in months)
                        {
                            <option value="@month" selected="@(month == selectedMonth)">@month</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-3">
                    <label class="font-weight-bold">Year</label>
                    <select name="year" class="form-control">
                        @foreach (var year in years)
                        {
                            <option value="@year" selected="@(year == selectedYear)">@year</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label class="font-weight-bold">Project</label>
                    <select name="project" class="form-control">
                        <option value="" selected="@string.IsNullOrWhiteSpace(selectedProject)">-- All Projects --</option>
                        @foreach (var project in projects)
                        {
                            <option value="@project" selected="@(project == selectedProject)">@project</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Load</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card h-100 border-info">
            <div class="card-body">
                <h6 class="text-muted">Total Customers</h6>
                <h3 class="mb-0">@ViewBag.TotalCustomers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <h6 class="text-muted">Total Bills Amount</h6>
                <h3 class="mb-0">@totalBillsAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 border-success">
            <div class="card-body">
                <h6 class="text-muted">Total Paid Amount</h6>
                <h3 class="mb-0 text-success">@totalPaidAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 border-danger">
            <div class="card-body">
                <h6 class="text-muted">Total Unpaid Amount</h6>
                <h3 class="mb-0 text-danger">@totalUnpaidAmount.ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>
