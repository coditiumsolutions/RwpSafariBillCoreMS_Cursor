@model BMSBT.Models.CustomersMaintenance
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Maintenance Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Edit Maintenance Customer</h3>
    <a asp-action="CustomersMaintenance" asp-controller="MaintenanceNew" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color:#101f63;">
        <h5 class="mb-0">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "—" : Model.CustomerName.Trim())<span class="mx-2 opacity-75">·</span>@(string.IsNullOrWhiteSpace(Model.BTNo) ? "—" : Model.BTNo.Trim())</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Uid" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <h6 class="text-muted border-bottom pb-1 mb-3">Identity</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="CustomerNo" class="form-label fw-bold">KuickPay No <span class="text-danger">*</span></label>
                    <input asp-for="CustomerNo" class="form-control" maxlength="20" />
                    <span asp-validation-for="CustomerNo" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="BTNo" class="form-label fw-bold">BT No</label>
                    <input asp-for="BTNo" class="form-control" maxlength="20" />
                    <span asp-validation-for="BTNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CustomerName" class="form-label fw-bold">Customer Name</label>
                    <input asp-for="CustomerName" class="form-control" maxlength="200" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="FatherName" class="form-label fw-bold">Father Name</label>
                    <input asp-for="FatherName" class="form-control" maxlength="70" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="CNICNo" class="form-label fw-bold">CNIC No</label>
                    <input asp-for="CNICNo" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="MobileNo" class="form-label fw-bold">Mobile No</label>
                    <input asp-for="MobileNo" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="City" class="form-label fw-bold">City</label>
                    <input asp-for="City" class="form-control" maxlength="50" />
                </div>
            </div>

            <h6 class="text-muted border-bottom pb-1 mb-3 mt-2">Property</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Project" class="form-label fw-bold">Project <span class="text-danger">*</span></label>
                    <select asp-for="Project" id="projectSelect" class="form-control"
                            asp-items="@(ViewBag.ProjectList as IEnumerable<SelectListItem>)">
                        <option value="">-- Select Project --</option>
                    </select>
                    <span asp-validation-for="Project" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="SubProject" class="form-label fw-bold">Phase Name <span class="text-danger">*</span></label>
                    <select asp-for="SubProject" id="phaseSelect" class="form-control"
                            asp-items="@(ViewBag.PhaseNameList as IEnumerable<SelectListItem>)">
                        <option value="">-- Select Phase Name --</option>
                    </select>
                    <span asp-validation-for="SubProject" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Category" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                    <select asp-for="Category" class="form-control"
                            asp-items="@(ViewBag.CategoryList as IEnumerable<SelectListItem>)">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Size" class="form-label fw-bold">Size</label>
                    <input asp-for="Size" class="form-control" maxlength="50" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Sector" class="form-label fw-bold">Sector</label>
                    <input asp-for="Sector" class="form-control" maxlength="100" />
                    <span asp-validation-for="Sector" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="PloNo" class="form-label fw-bold">Plot No <span class="text-danger">*</span></label>
                    <input asp-for="PloNo" class="form-control" maxlength="100" />
                    <span asp-validation-for="PloNo" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="StreetNumber" class="form-label fw-bold">Street Number</label>
                    <input asp-for="StreetNumber" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="UnitType" class="form-label fw-bold">Unit Type</label>
                    <input asp-for="UnitType" class="form-control" maxlength="50" />
                </div>
            </div>

            <h6 class="text-muted border-bottom pb-1 mb-3 mt-2">Charges</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Maint" class="form-label fw-bold">Maint</label>
                    <input asp-for="Maint" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Misc" class="form-label fw-bold">Misc</label>
                    <input asp-for="Misc" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Water" class="form-label fw-bold">Water</label>
                    <input asp-for="Water" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Rent" class="form-label fw-bold">Rent</label>
                    <input asp-for="Rent" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Generator" class="form-label fw-bold">Generator</label>
                    <input asp-for="Generator" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Other" class="form-label fw-bold">Other</label>
                    <input asp-for="Other" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="FoodSafety" class="form-label fw-bold">Food Safety</label>
                    <input asp-for="FoodSafety" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="TrollyTrip" class="form-label fw-bold">Trolly Trip</label>
                    <input asp-for="TrollyTrip" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ExtraWork" class="form-label fw-bold">Extra Work</label>
                    <input asp-for="ExtraWork" type="number" step="0.01" class="form-control" />
                </div>
            </div>

            <h6 class="text-muted border-bottom pb-1 mb-3 mt-2">Status</h6>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="ConnectionStatus" class="form-label fw-bold">Connection Status</label>
                    <select asp-for="ConnectionStatus" class="form-control"
                            asp-items="@(ViewBag.ConnectionStatusList as IEnumerable<SelectListItem>)">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="PlotStatus" class="form-label fw-bold">Plot Status</label>
                    <input asp-for="PlotStatus" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="BillGenerationStatus" class="form-label fw-bold">Bill Generation Status</label>
                    <input asp-for="BillGenerationStatus" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="LocationSeqNo" class="form-label fw-bold">Location Seq No</label>
                    <input asp-for="LocationSeqNo" class="form-control" maxlength="50" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa fa-save"></i> Save Changes
                    </button>
    <a asp-action="Customer" asp-controller="Home" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var currentPhase = '@Html.Raw(Model.SubProject?.Replace("'", "\\'") ?? "")';

            function loadPhases(project, selectValue) {
                var $phase = $('#phaseSelect');
                $phase.empty().append($('<option>').val('').text('-- Select Phase Name --'));
                if (!project) return;

                $.getJSON('@Url.Action("GetPhasesByProject", "CustomersMaintenance")', { project: project }, function (data) {
                    $.each(data, function (i, phase) {
                        var $opt = $('<option>').val(phase).text(phase);
                        if (phase === selectValue) $opt.prop('selected', true);
                        $phase.append($opt);
                    });
                });
            }

            // On project change: reload phases, clear selected phase
            $('#projectSelect').change(function () {
                loadPhases($(this).val(), '');
            });

            // On page load: if a project is already selected, reload its phases and re-select the current phase
            var currentProject = $('#projectSelect').val();
            if (currentProject) {
                loadPhases(currentProject, currentPhase);
            }
        });
    </script>
}

